<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ─── Converter %clr (couleurs Spring Boot) ───────────────────────── -->
    <conversionRule conversionWord="clr"
                    converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
                    converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>

    <!-- ─── Appender Console ─────────────────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([${spring.application.name:-config},%X{traceId:-},%X{spanId:-}]){cyan} %clr(%-40.40logger{39}){magenta} %clr(:){faint} %m%n</pattern>
        </encoder>
    </appender>

    <!-- ─── Appender Loki ────────────────────────────────────────────────── -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://localhost:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>app=${spring.application.name:-config},level=%level,host=${HOSTNAME:-localhost}</pattern>
            </label>
            <message>
                <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}","level":"%level","app":"${spring.application.name:-config}","traceId":"%X{traceId:-none}","spanId":"%X{spanId:-none}","logger":"%logger","message":"%message","exception":"%ex{short}"}</pattern>
            </message>
            <sortByTime>true</sortByTime>
        </format>
    </appender>

    <logger name="com.mediconnect" level="DEBUG"/>
    <logger name="org.springframework.cloud.config.server" level="INFO"/>
    <logger name="org.springframework.cloud.config.server.environment" level="INFO"/>
    <logger name="com.netflix.eureka" level="WARN"/>
    <logger name="com.netflix.discovery" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>

</configuration>